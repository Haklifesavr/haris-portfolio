# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values: this repository is public.

# Admin login (/admin/login)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# Lets the admin panel save by committing to this repo (which triggers a Vercel deploy).
# Fine-grained token: this repository only, "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=haklifesavr/haris-portfolio
GITHUB_BRANCH=master

# Contact form (EmailJS) — already used by the old site
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_USER_ID=
